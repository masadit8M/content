datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  avatar       String?
  title        String?  // e.g. "Marketing Lead", "Content Creator", "Graphic Designer", "Social Media Specialist"
  role         String   @default("ADMIN") // "LEAD", "CREATOR", "DESIGNER", "ADMIN"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  createdContents   MarketingContent[] @relation("CreatedContents")
  assignedContents  MarketingContent[] @relation("AssignedContents")
  createdTasks      ContentTask[]      @relation("CreatedTasks")
  assignedTasks     ContentTask[]      @relation("AssignedTasks")
  comments          ContentComment[]
  taggedComments    ContentComment[]   @relation("TaggedComments")
}

model MarketingContent {
  id           String    @id @default(cuid())
  title        String
  description  String?   // Brief / Konsep utama
  platform     String    @default("INSTAGRAM") // "INSTAGRAM", "TIKTOK", "YOUTUBE", "FACEBOOK" (legacy: "LINKEDIN", "WEBSITE")
  contentType  String    @default("FEED_CAROUSEL") // Kode format jadwal: "REELS" (R), "FEED_CAROUSEL" (C), "VIDEO_TUTORIAL" (V), "STORY" (S), "REEL_TREND" (RD), "BANNER" (poster). Legacy: "TIKTOK_VIDEO", "YOUTUBE_VIDEO"
  // Tahap Bank Konten: "IDEA" (brief dari Studio) -> "RAW_MATERIAL" -> "IN_REVIEW" <-> "NEED_REVISION" -> "READY_TO_PUBLISH" -> "PUBLISHED"
  // Legacy "IN_EDITING"/"IN_PREPARATION" dibaca sebagai RAW_MATERIAL (belum ada hasil edit) atau IN_REVIEW (sudah ada hasil edit).
  status       String    @default("RAW_MATERIAL")

  // Keterkaitan dengan Jadwal Marketing (src/lib/marketing-plan.ts)
  themeId      String?   // id item jadwal, contoh "hb-hari-pahlawan", "tp-profesi"
  themeLabel   String?   // label ringkas agar tetap terbaca walau jadwal berubah
  origin       String?   // "FIELD" (bahan lapangan), "PROPOSAL" (usulan/produksi mandiri), "STUDIO" (brief dari Studio Ide)
  caption      String?   // Caption final + hashtag yang siap disalin ke medsos
  rawFiles     String?   // JSON array [{url,name,type,size}] seluruh bahan mentah
  editedFiles  String?   // JSON array [{url,name,type,size}] seluruh hasil edit / slide carousel
  
  // File Mentah (Raw Footage / Image / Video)
  rawAssetUrl   String?
  rawAssetName  String?
  rawAssetType  String?   // "IMAGE", "VIDEO", "LINK", "DOCUMENT"

  // Hasil Editing & Versi Revisi
  editedAssetUrl  String?
  editedAssetName String?
  editedAssetType String?
  revisionNote    String?
  version         Int       @default(1)

  // Persiapan yang sudah dibuat oleh admin (draft caption, naskah, dll)
  prepNotes    String?   // Catatan persiapan: draft caption, naskah/script, angle visual, bahan riset
  assetUrl     String?   // Link asset/preview umum
  assetName    String?   // Nama file atau label asset
  
  // Hasil Live (Publish) & Daftar Link Multi-Platform
  liveUrl        String?   // Link postingan utama (kompatibilitas)
  publishedLinks String?   // JSON array [{id,platform,url,label,addedBy,addedAt}] seluruh link tempat konten diupload
  liveNote       String?   // Catatan saat live
  publishedAt    DateTime? // Waktu dipublikasikan
  claimedAt      DateTime? // Waktu bahan mentah diambil untuk diedit
  
  targetDate   DateTime? // Target tanggal tayang
  
  createdById  String
  createdBy    User      @relation("CreatedContents", fields: [createdById], references: [id], onDelete: Cascade)
  
  assignedToId String?
  assignedTo   User?     @relation("AssignedContents", fields: [assignedToId], references: [id], onDelete: SetNull)

  tasks        ContentTask[]
  comments     ContentComment[]

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model ContentTask {
  id           String    @id @default(cuid())
  contentId    String
  content      MarketingContent @relation(fields: [contentId], references: [id], onDelete: Cascade)
  
  title        String    // Deskripsi task tambahan
  isCompleted  Boolean   @default(false)
  
  createdById  String
  createdBy    User      @relation("CreatedTasks", fields: [createdById], references: [id], onDelete: Cascade)
  
  assignedToId String?
  assignedTo   User?     @relation("AssignedTasks", fields: [assignedToId], references: [id], onDelete: SetNull)
  
  dueDate      DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model ContentComment {
  id        String   @id @default(cuid())
  contentId String
  content   MarketingContent @relation(fields: [contentId], references: [id], onDelete: Cascade)
  
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  message      String
  kind         String   @default("COMMENT") // "COMMENT" (diskusi tim) atau "LOG" (riwayat otomatis perubahan tahap)
  taggedUserId String?
  taggedUser   User?    @relation("TaggedComments", fields: [taggedUserId], references: [id], onDelete: SetNull)
  
  createdAt DateTime @default(now())
}
